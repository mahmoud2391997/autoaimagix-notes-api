NODE_ENV=development
PORT=3000
LOCAL_POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql://notesapi:replace-with-a-random-local-password@127.0.0.1:5433/notesapi?schema=public
# For remote Neon schema setup, set the direct (non-pooler) URL in .env.neon:
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DB?sslmode=require
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=1h
OPENWEATHER_API_KEY=your-openweathermap-key
CORS_ORIGINS=http://localhost:3000
LOCAL_REDIS_TOKEN=replace-with-a-random-local-redis-token
UPSTASH_REDIS_REST_URL=http://127.0.0.1:8079
UPSTASH_REDIS_REST_TOKEN=replace-with-a-random-local-redis-token
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Change-me-strong-password1
